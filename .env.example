# ==============================================================================
# Environment Variables for LINE Expense Bot
# Set these variables in the Render Dashboard under "Environment Variables"
# ==============================================================================

# Server Port (Render sets this automatically, default 3000 for local)
PORT=3000

# LINE Messaging API Credentials (From https://developers.line.biz/)
# Basic settings -> Channel secret
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Messaging API -> Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Supabase Credentials (From https://supabase.com/dashboard/project/<id>/settings/api)
# Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Project API Keys -> service_role key (secret, allows server backend to bypass RLS)
# Note: Supabase Free Tier auto-pauses after 7 days of inactivity. Resume it via Supabase Dashboard.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Anthropic Claude API (From https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Model name (defaults to claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
