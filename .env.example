# ==============================================================================
# Environment Variables for LINE Expense Bot
# Set these variables in the Render/Railway Dashboard under "Environment Variables"
# ==============================================================================

# Server Port (Render sets this automatically, default 3000 for local)
PORT=3000

# LINE Messaging API Credentials (From https://developers.line.biz/)
# Basic settings -> Channel secret
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Messaging API -> Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Supabase Credentials (From https://supabase.com/dashboard/project/<id>/settings/api)
# Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Project API Keys -> service_role key (secret, allows server backend to bypass RLS)
# Note: Supabase Free Tier auto-pauses after 7 days of inactivity. Resume it via Supabase Dashboard.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Google Gemini (From https://aistudio.google.com/apikey) — used to structure slips into JSON
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Model name (defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Optional: Thinking budget. 0 = disable thinking (fastest, recommended for slip
# extraction). Negative = leave the model default.
GEMINI_THINKING_BUDGET=0

# Optional: SCB 10X Typhoon OCR (From https://opentyphoon.ai/) — reads Thai slip
# text before Gemini. When set, Gemini is called text-only which is much faster.
TYPHOON_API_KEY=your_typhoon_api_key_here

# Optional: Typhoon OCR model (defaults to typhoon-ocr-v1.5)
TYPHOON_MODEL=typhoon-ocr-v1.5

# Optional: LIFF app id (LINE Frontend Framework) for the web UI
LIFF_ID=your_liff_id_here

# Optional: Admin API key for /admin endpoints
ADMIN_KEY=your_admin_key_here
