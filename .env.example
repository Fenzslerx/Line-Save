# ==============================================================================
# Line-Save (นับล้าน) — environment variables
#
# Production (Cloudflare Workers): ตั้งผ่าน `npx wrangler secret put <NAME>`
#   (ดูรายการทั้งหมดใน DEPLOY_GUIDE.md ขั้น 3)
# Local dev: คัดลอกไฟล์นี้เป็น .dev.vars หรือ .env แล้วใส่ค่าจริง
# ==============================================================================

# --- LINE Messaging API (https://developers.line.biz) ---
# Basic settings -> Channel secret
LINE_CHANNEL_SECRET=your_line_channel_secret_here
# Messaging API -> Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# --- AI: Google Gemini (https://aistudio.google.com) — เฉพาะสลิปที่ rule parser อ่านไม่ได้ ---
GEMINI_API_KEY=your_gemini_api_key_here
# optional: model (default gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash
# optional: 0 = ปิด thinking (เร็วสุด, default); -1 = ปล่อยค่า default ของโมเดล
# GEMINI_THINKING_BUDGET=0

# --- OCR: SCB 10X Typhoon (https://opentyphoon.ai) — อ่านข้อความสลิปไทย ---
TYPHOON_API_KEY=your_typhoon_api_key_here
# optional: model (default typhoon-ocr-v1.5)
# TYPHOON_MODEL=typhoon-ocr-v1.5

# --- LIFF (LINE Developers console > LIFF tab) ---
LIFF_ID=your_liff_id_here

# --- Admin dashboard (/admin) — รหัสผ่านยาว 10+ ตัวอักษร ---
ADMIN_KEY=your_admin_key_here

# --- Local dev only (Express server) ---
# PORT=3000
